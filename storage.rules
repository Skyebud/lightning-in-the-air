rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active != false;
    }

    match /public/{folder}/{allPaths=**} {
      allow read: if folder in ["photos", "members"];
      allow create, update: if folder in ["photos", "members"]
        && isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if folder in ["photos", "members"] && isAdmin();
    }
  }
}
